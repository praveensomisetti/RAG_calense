# --- LLM (OpenAI by default). Leave the key empty to run in deterministic no-LLM mode.
OPENAI_API_KEY=
CHEMRAG_LLM_PROVIDER=openai          # openai | gemini | none
CHEMRAG_LLM_MODEL=gpt-5-mini         # budget pick; cheapest: gpt-5-nano. `chemrag doctor` lists ids your key can use
CHEMRAG_LLM_REASONING_EFFORT=low     # for reasoning models (gpt-5*, o*): none|minimal|low|medium|high; empty = model default
# GEMINI_API_KEY=                    # only if CHEMRAG_LLM_PROVIDER=gemini (pip install -e ".[gemini]")
CHEMRAG_LLM_TIMEOUT_S=20

# --- Embeddings + vector store (embedded Chroma, no server)
CHEMRAG_EMBED_MODEL=thenlper/gte-large   # fallback for low RAM: thenlper/gte-base ; offline dev: hash-ngram
CHEMRAG_EMBED_BATCH=32
CHEMRAG_TORCH_THREADS=4
CHEMRAG_VECTOR_PATH=data/processed/chroma

# --- Data
CHEMRAG_CSV_PATH=data/raw/interviewtestdataset.csv
CHEMRAG_DB_PATH=data/processed/cscp.duckdb
CHEMRAG_DUCKDB_MEMORY_LIMIT=1GB
CHEMRAG_DUCKDB_THREADS=2
